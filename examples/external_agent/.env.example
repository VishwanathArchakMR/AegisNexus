# AegisNexus External Agent Configuration
# Obtain AGENT_ID and API_KEY from the AegisNexus dashboard Onboarding Wizard
AEGISNEXUS_ENDPOINT=http://localhost:8000/api/v1
AEGISNEXUS_AGENT_ID=your-agent-uuid-here
AEGISNEXUS_API_KEY=anx_live_your_api_key_here
AEGISNEXUS_HEARTBEAT_INTERVAL=15
AEGISNEXUS_FLUSH_INTERVAL=2.0
AEGISNEXUS_FAIL_OPEN=true
AEGISNEXUS_SDK_VERSION=0.2.0
