# ==============================================================================
# AegisNexus Backend Environment Configuration
# ==============================================================================

# Application settings
APP_NAME=AegisNexus
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server bind settings
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
DOCS_ENABLED=true

# Database (Default: local zero-setup SQLite; for Postgres: postgresql+asyncpg://user:pass@host:5432/db)
DATABASE_URL=sqlite+aiosqlite:///./aegisnexus.db
SEED_ON_STARTUP=true

# Security & CORS (Comma-separated for multiple origins)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
